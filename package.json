{
  "name": "yomio-mcp-stdio",
  "mcpName": "app.yomio/yomio-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "Connect an MCP-compatible AI client to Yomio with browser sign-in",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtemGontar/yomio-mcp.git"
  },
  "homepage": "https://yomio.app/en/developers/mcp",
  "keywords": [
    "mcp",
    "yomio",
    "oauth",
    "expenses"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "yomio-mcp-stdio": "index.mjs"
  },
  "files": [
    "index.mjs",
    "bridge.mjs",
    "callbackServer.mjs",
    "credentialStore.mjs",
    "endpoint.mjs",
    "oauthProvider.mjs",
    "authRecovery.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test",
    "check": "node --check index.mjs && node --check bridge.mjs && node --check callbackServer.mjs && node --check credentialStore.mjs && node --check endpoint.mjs && node --check oauthProvider.mjs && node --check authRecovery.mjs && tsc -p .",
    "prepublishOnly": "npm test && npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
